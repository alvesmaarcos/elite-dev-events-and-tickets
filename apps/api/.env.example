# Valores prontos para rodar local com o Postgres do docker-compose.
# A porta 5433 e proposital: a 5432 costuma estar ocupada por um Postgres
# instalado na maquina.
DATABASE_URL="postgresql://elitedev:elitedev@localhost:5433/elitedev?schema=public"

# Segredos de desenvolvimento. Em producao, valores diferentes e fora do
# repositorio. JWT_SECRET assina o login; QR_SECRET assina o ingresso -- e o
# que impede alguem de inventar um codigo e desenhar o proprio QR.
JWT_SECRET="dev-jwt-secret-trocar-em-producao"
QR_SECRET="dev-qr-secret-trocar-em-producao"

# Chave da TMDb. Aceita tanto a API Key v3 (32 caracteres) quanto o Read
# Access Token v4 (comeca com "eyJ") -- a aplicacao detecta qual e.
# Sem chave, o catalogo cai em uma lista fixa de exemplo.
TMDB_API_KEY=""

PORT=3333

# De onde o navegador pode chamar a API. Em producao, o dominio do front.
CORS_ORIGIN="http://localhost:5173"
