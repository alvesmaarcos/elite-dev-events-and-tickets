// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}


enum Role {
  ORGANIZER
  CLIENT
  GATE
}
model User {
  id        String @id @default(cuid())
  email     String @unique
  password  String
  name      String
  role      Role
  events    Event[]
  createdAt DateTime @default(now())
  reservations Reservation[]
}
model Event {
  id             String   @id @default(cuid())
  title          String
  description    String?
  posterUrl      String?
  externalSource String?
  externalId     String?
  date           DateTime
  location       String
  price          Float
  organizerId    String
  organizer      User     @relation(fields: [organizerId], references: [id])
  createdAt      DateTime @default(now())
  roomRows        Int
  roomSeatsPerRow Int
  seats           Seat[]
  reservations Reservation[]
  // Guardamos a DATA, nao um boolean: se esta vazio nao foi cancelado, se
  // esta preenchido foi cancelado E sabemos quando. Mesmo padrao do usedAt.
  canceledAt      DateTime?
}

enum SeatStatus {
  AVAILABLE
  HELD
  SOLD
}

model Seat {
  id      String     @id @default(cuid())
  eventId String
  event   Event      @relation(fields: [eventId], references: [id])
  row     String
  number  Int
  label   String
  status  SeatStatus @default(AVAILABLE)
  holdExpiresAt DateTime?
  holdByUserId  String?
  ticket Ticket?
  
  @@unique([eventId, label])
}

enum TicketStatus {
  VALID
  USED
  CANCELED
}

model Reservation {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id])
  clientId  String
  client    User     @relation(fields: [clientId], references: [id])
  createdAt DateTime @default(now())
  tickets   Ticket[]
}

model Ticket {
  id            String       @id @default(cuid())
  reservationId String
  reservation   Reservation  @relation(fields: [reservationId], references: [id])
  seatId        String       @unique
  seat          Seat         @relation(fields: [seatId], references: [id])
  code          String       @unique
  signature     String
  status        TicketStatus @default(VALID)
  usedAt        DateTime?
  canceledAt    DateTime?
  createdAt     DateTime     @default(now())
}
